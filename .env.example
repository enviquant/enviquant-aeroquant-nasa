# Root compose config — copy to .env for `docker compose up` (never commit .env)
# Frontend build args (baked at `docker compose build` time):
REACT_APP_DASHBOARD_PASSWORD=change-me
# Leave WS/API empty for same-origin (nginx proxies /ws + /api to backend):
# REACT_APP_WS_URL=wss://example.com/ws
# REACT_APP_API_URL=https://example.com
