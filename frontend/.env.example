# AeroQuant frontend — copy to .env and fill in (never commit .env)
# Same-origin default (nginx proxies /ws + /api to backend) works for docker compose.
# Only set these for split deployments (e.g. Vercel frontend + VPS backend).
# REACT_APP_WS_URL=wss://example.com/ws
# REACT_APP_API_URL=https://example.com

# Required for production: dashboard gate password (no default committed).
REACT_APP_DASHBOARD_PASSWORD=change-me
