# AeroQuant backend — copy to .env and fill in (never commit .env)
# For docker compose, Mosquitto defaults below work out of the box.

# MQTT (self-hosted Mosquitto in compose; override for external broker)
MQTT_BROKER=mosquitto
MQTT_PORT=1883
MQTT_CLIENT_ID=aeroponics-server-01
MQTT_TOPIC_SENSOR=aeroponics/sensors
MQTT_TOPIC_CONTROL=aeroponics/control
MQTT_TOPIC_ACK=aeroponics/ack

# HTTP / WebSocket
WS_PORT=8071

# NASA POWER forecast location + threshold
NASA_LAT=23.8103
NASA_LON=90.4074
NASA_THRESHOLD=35.0
NASA_FETCH_INTERVAL_MIN=30
